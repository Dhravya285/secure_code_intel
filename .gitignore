# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
.installed.cfg

# --- Virtual environments ---
venv/
env/
ENV/
.venv/
.env/

# --- Environment variables / secrets ---
.env
.env.local
.env.*.local
*.env

# --- Output files (generated at runtime) ---
outputs/scan_results.json
outputs/scored_vulns.json
outputs/final_report.json
outputs/cluster_report.json
outputs/evaluation_results.json
outputs/comparison_report.json

# Keep outputs folder tracked but not its contents
!outputs/.gitkeep

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Logs ---
*.log
logs/

# --- Test coverage ---
.coverage
htmlcov/
.pytest_cache/
.tox/

# --- Databases (generated by test files) ---
*.db
*.sqlite
*.sqlite3

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db